 "signals": [
  {
   "id": "firebase_analytics",
   "name": "Firebase / Google Analytics",
   "pattern": "firebase_analytics|FirebaseAnalytics|firebase-analytics|@react-native-firebase/analytics|google-analytics",
   "kind": "sdk",
   "transmits": true,
   "data": [
    "app_interactions",
    "device_id",
    "approx_location",
    "purchase_history"
   ],
   "purposes": [
    "Analytics"
   ],
   "tracking": false,
   "hint": "Google's Analytics for Firebase Android article lists: app-instance ID, Android advertising ID (can be disabled), coarse location derived from masked IP, in-app purchase events, screen and session events. The Apple article was not read.",
   "verified": "2026-11-25 (Android article; Apple article not read)",
   "sources": [
    "https://support.google.com/analytics/answer/11582702",
    "https://firebase.google.com/docs/android/play-data-disclosure"
   ],
   "disabled_pattern": "firebase_analytics_collection_deactivated[\"'\\s]+android:value\\s*=\\s*[\"']true|firebase_analytics_collection_enabled[\"'\\s]+android:value\\s*=\\s*[\"']false|FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>\\s*<false|FIREBASE_ANALYTICS_COLLECTION_DEACTIVATED</key>\\s*<true|setAnalyticsCollectionEnabled\\(\\s*false"
  },
  {
   "id": "crashlytics",
   "name": "Firebase Crashlytics",
   "pattern": "(?i)crashlytics",
   "kind": "sdk",
   "transmits": true,
   "data": [
    "crash_logs",
    "diagnostics",
    "device_id"
   ],
   "purposes": [
    "Analytics",
    "App functionality"
   ],
   "tracking": false,
   "hint": "Collects stack traces, app state, device metadata and a Crashlytics installation UUID. Custom keys, logs and free-text user IDs you attach are also collected.",
   "verified": "2026-11-25",
   "sources": [
    "https://firebase.google.com/docs/android/play-data-disclosure",
    "https://firebase.google.com/docs/ios/app-store-data-collection"
   ],
   "disabled_pattern": "firebase_crashlytics_collection_enabled[\"'\\s]+android:value\\s*=\\s*[\"']false|FirebaseCrashlyticsCollectionEnabled</key>\\s*<false|setCrashlyticsCollectionEnabled\\(\\s*false"
  },
  {
   "id": "firebase_auth",
   "name": "Firebase Auth",
   "pattern": "firebase_auth|FirebaseAuth|firebase-auth|@react-native-firebase/auth|createUserWithEmailAndPassword",
   "kind": "sdk",
   "transmits": true,
   "data": [
    "user_id",
    {
     "key": "email",
     "usage_dependent": true
    },
    {
     "key": "name",
     "usage_dependent": true
    },
    {
     "key": "phone",
     "usage_dependent": true
    }
   ],
   "purposes": [
    "Account management",
    "App functionality"
   ],
   "tracking": false,
   "hint": "Always generates identifiers for authentication and collects IP addresses (abuse prevention). Display name, email and phone are collected only depending on how you use it. Google says approximate location inferred from IP must be disclosed.",
   "verified": "2026-11-25",
   "sources": [
    "https://firebase.google.com/docs/android/play-data-disclosure",
    "https://firebase.google.com/docs/ios/app-store-data-collection"
   ]
  },
  {
   "id": "fcm",
   "name": "Firebase Cloud Messaging",
   "pattern": "firebase_messaging|FirebaseMessaging|firebase-messaging",
   "kind": "sdk",
   "transmits": true,
   "data": [
    "device_id"
   ],
   "purposes": [
    "App functionality",
    "Developer communications"
   ],
   "tracking": false,
   "hint": "Uses the Firebase installation ID as the registration token (Apple: APNs token plus installation ID) and collects device model, language, time zone and OS version for topics.",
   "verified": "2026-11-25",
   "sources": [
    "https://firebase.google.com/docs/android/play-data-disclosure",
    "https://firebase.google.com/docs/ios/app-store-data-collection"
   ]
  },
  {
   "id": "onesignal",
   "name": "OneSignal",
   "pattern": "OneSignal",
   "kind": "sdk",
   "transmits": true,
   "data": [
    {
     "key": "purchase_history",
     "usage_dependent": true
    },
    "app_interactions",
    {
     "key": "device_id",
     "only": "apple"
    },
    {
     "key": "user_id",
     "only": "apple"
    }
   ],
   "purposes": [
    "Analytics"
   ],
   "tracking": false,
   "hint": "Default collection per OneSignal: in-app purchase events and usage (sessions, notification clicks). Apple page: OneSignal assigns a unique OneSignal ID under Identifiers. Google page: device IDs not collected by default (only if you link aliases). Email, phone and tags you send add more types.",
   "verified": "2026-11-25",
   "sources": [
    "https://documentation.onesignal.com/docs/apple-app-privacy-requirements",
    "https://documentation.onesignal.com/docs/google-play-data-safety-requirements"
   ]
  },
