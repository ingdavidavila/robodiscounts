  {
   "id": "admob",
   "name": "Google AdMob / Mobile Ads",
   "pattern": "google_mobile_ads|play-services-ads|GoogleMobileAds|react-native-google-mobile-ads|expo-ads-admob",
   "kind": "sdk",
   "transmits": true,
   "data": [
    "device_id",
    "app_interactions",
    "diagnostics",
    "approx_location",
    "ad_data",
    {
     "key": "crash_logs",
     "only": "apple"
    }
   ],
   "purposes": [
    "Advertising or marketing",
    "Analytics"
   ],
   "tracking": true,
   "hint": "Per Google: IP address (general location), user product interactions, diagnostics (launch time, hang rate, energy), device and account identifiers (advertising ID, app set ID). The Apple page also lists crash logs and advertising data. Whether this counts as tracking under Apple's definition depends on your ad setup.",
   "verified": "2026-11-25",
   "sources": [
    "https://developers.google.com/admob/ios/data-disclosure",
    "https://developers.google.com/admob/android/privacy/play-data-disclosure"
   ]
  },
  {
   "id": "facebook",
   "name": "Facebook SDK",
   "pattern": "FBSDKCoreKit|facebook_app_events|react-native-fbsdk|com\\.facebook\\.android|flutter_facebook_auth",
   "kind": "sdk",
   "transmits": true,
   "data": [
    "device_id",
    {
     "key": "app_interactions",
     "usage_dependent": true
    },
    {
     "key": "user_id",
     "usage_dependent": true
    }
   ],
   "purposes": [
    "Analytics",
    "Advertising or marketing"
   ],
   "tracking": true,
   "hint": "Meta's post (July 2022, dated) lists device identifiers, device attributes and network information including IP. App events are what you send plus automatic install/launch/purchase events. Facebook Login adds a user-specific identifier. Advanced matching can add email, name, phone, address, gender, date of birth.",
   "verified": "2026-11-25 (2022 Meta post)",
   "sources": [
    "https://developers.facebook.com/blog/post/2022/07/18/resources-for-completing-app-store-data-practice-questionnaires-apps-facebook-or-audience-network-sdk/"
   ]
