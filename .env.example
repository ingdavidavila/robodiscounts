# Meta WhatsApp Cloud API (https://developers.facebook.com/apps -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Your own number, international format
WHATSAPP_TO=+521234567890
# Optional but recommended: approved template name (see README). Without it,
# free-text is used and only works within 24h of you messaging the business number.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US
# Optional 1-variable template for bot-health messages, body: "robodiscounts: {{1}}"
WHATSAPP_STATUS_TEMPLATE=

# Best Buy Products API key (free): https://developer.bestbuy.com
BESTBUY_API_KEY=
